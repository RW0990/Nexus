<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Trip</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body>
    <%- include('partials/nav') %>

    <h1>My Trips</h1>

    <% const destinations = Object.keys(tripsByDestination); %>

    <% if (destinations.length === 0) { %>
      <p>No trips yet. Add a booking to get started.</p>
    <% } else { %>
      <% destinations.forEach((destination) => { %>
        <div class="trip-category">
          <h2><%= destination %></h2>

          <div class="trip-bookings">
            <% tripsByDestination[destination].forEach((booking) => { %>
              <div class="trip-booking-item">
                <p><strong>Departure:</strong> <%= new Date(booking.departureDate).toLocaleDateString() %></p>
                <p><strong>Return:</strong> <%= new Date(booking.returnDate).toLocaleDateString() %></p>
                <% if (booking.flightNumber) { %>
                  <p><strong>Flight:</strong> <%= booking.flightNumber %></p>
                <% } %>
                <% if (booking.hotel) { %>
                  <p><strong>Hotel:</strong> <%= booking.hotel %></p>
                <% } %>
                <% if (booking.notes) { %>
                  <p><strong>Notes:</strong> <%= booking.notes %></p>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </body>
</html>