<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>New Booking</title>
        <link rel="stylesheet" href="/style.css" />
        <link rel="stylesheet"
            href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link
            href="https://fonts.googleapis.com/css2?family=Roboto:wdth@75&display=swap"
            rel="stylesheet">
    </head>

    <body class="new-booking-page">

        <%- include('partials/nav') %>

        <main class="new-booking-container">

            <h1>Create a New Booking</h1>

            <form action="/NewBooking" method="POST" class="new-booking-form">

                <% if (error) { %>
                <p class="auth-error"><%= error %></p>
                <% } %>

                <label for="destination">Destination</label>
                <input
                    type="text"
                    id="destination"
                    name="destination"
                    placeholder="Enter destination"
                    required />

                <label for="departureDate">Departure date</label>
                <input
                    type="date"
                    id="departureDate"
                    name="departureDate"
                    min="<%= today %>"
                    required />

                <label for="returnDate">Return date</label>
                <input
                    type="date"
                    id="returnDate"
                    name="returnDate"
                    required />
                <br>
                <label for="hotel">Hotel</label>
                <input
                    type="text"
                    id="hotel"
                    name="hotel"
                    placeholder="Enter hotel name" />
                <label for="hotelAddress">Hotel Address</label>
                <input
                    type="text"
                    id="hotelAddress"
                    name="hotelAddress"
                    placeholder="Enter hotel address" />
                    <label for="hotelBookingReference">Hotel booking reference</label>
                <input
                    type="text"
                    id="hotelBookingReference"
                    name="hotelBookingReference"
                    placeholder="Enter booking reference" />
                <br>
                <label for="flightNumber">Flight number</label>
                <input
                    type="text"
                    id="flightNumber"
                    name="flightNumber"
                    placeholder="Enter flight number" />
                <label for="airline">Airline</label>
                <input
                    type="text"
                    id="airline"
                    name="airline"
                    placeholder="Enter airline name" />
                    <label for="flightReferenceNumber">Flight reference number</label>
                <input
                    type="text"
                    id="flightReferenceNumber"
                    name="flightReferenceNumber"
                    placeholder="Enter flight reference number" />
                <br>
                <label for="notes">Notes</label>
                <textarea
                    id="notes"
                    name="notes"
                    placeholder="Add any extra details"></textarea>

                <button type="submit">Create Booking</button>

            </form>

        </main>

    </body>
</html>