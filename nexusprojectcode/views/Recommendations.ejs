<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Recommendations</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wdth@75&display=swap"
      rel="stylesheet" />
  </head>

  <body>
    <%- include('partials/nav') %>

    <h1 class="recommendations-title">Recommendations</h1>

    <% if (!hasBookings) { %>
      <p class="no-booking-recommendations">You don't have any bookings yet. Add a trip to see personalized recommendations.</p>
    <% } else if (events.length === 0) { %>
      <p class="no-recommendations">No recommendations available for your booked destinations yet.</p>
    <% } else { %>
      <div class="recommendations-list">
        <% events.forEach((event) => { %>
          <div class="recommendation-item">
            <h2><%= event.destination %></h2>
            <p><%= event.description %></p>
            <p><strong>Tickets available:</strong> <%= event.noOfTickets %></p>
            <% if (event.VIP === "Yes") { %>
              <span class="vip-badge">VIP</span>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </body>
</html>