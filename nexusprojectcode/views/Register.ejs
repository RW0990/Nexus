<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Register</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="auth-page">
    <div class="auth-card">
      <h1>Create an Account</h1>

      <% if (error) { %>
        <p class="auth-error"><%= error %></p>
      <% } %>

      <form action="/Register" method="POST" class="auth-form">
        <div class="input-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="email@email.com" required />
        </div>

        <div class="input-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Must be 0-9 characters" required />
        </div>

        <div class="input-group">
  <label for="username">Username</label>
  <input type="text" id="username" name="username" placeholder="Username" required />
</div>


        <div class="auth-buttons">
          <button type="submit" class="btn-enter">Enter</button>
          <button type="reset" class="btn-reset">Reset</button>
        </div>
      </form>

      <p class="auth-switch">Already have an account? <a href="/Login">Sign in</a></p>
    </div>
  </body>
</html>