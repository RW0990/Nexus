<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Flights</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wdth@75&display=swap"
      rel="stylesheet" />
  </head>

  <body class="Flights">
    <%- include('partials/nav') %>

    <main class="flight-page">
      <h1 id="bookingtitle">Flights</h1>

      <div class="flights-list">
        <% if (!bookings || bookings.length === 0) { %>
        <p>No flight bookings yet.</p>
        <% } else { %>
        <% bookings.forEach((booking) => { %>
        <section class="flight-card">
          <div class="flight-row">
            <div class="booking-icon">✈</div>
              <div class="flight-details-cards">
                <h2><%= booking.destination %></h2>
              </div>
              <div class="flight-details-cards">
                <p><strong>Flight number:</strong> <%= booking.flightNumber %></p>
              </div>
              <div class="flight-details-cards">
                <p><strong>Departure:</strong> <%= new
                  Date(booking.departureDate).toLocaleDateString() %></p>
              </div>  
              <div class="flight-details-cards">
                <p><strong>Return:</strong> <%= new
                  Date(booking.returnDate).toLocaleDateString() %></p>
              </div>
            </div>
          </div>
        </section>
        <% }); %>
        <% } %>
      </div>
    </main>
  </body>
</html>