<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Booking</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wdth@75&display=swap"
      rel="stylesheet">
  </head>
  <body class="Booking">
    <%- include('partials/nav') %>
    <main class="booking-page">
      <h1 id="bookingtitle">Your next booking</h1>
      <div class="new-booking" >
        <a href="/NewBooking">New Booking</a>
      </div>
      <br>
      <section class="booking-card">
        <div class="booking-row">
          <div class="booking-icon">✈</div>
          <div class="booking-info">
            <span class="booking-label">Flight</span>
            <p>Tokyo: 26th June</p>
          </div>
        </div>
        <div class="booking-row">
          <div class="booking-icon">🏨</div>
          <div class="booking-info">
            <span class="booking-label">Hotel</span>
            <p>Hotel Casa Sagnier: 26th-28th June</p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
